{
  "name": "islands-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build:core": "python3 scripts/build_core.py",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "demo": "bun run examples/service/server.ts",
    "examples": "bun run examples/run.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@islands/protocol": "workspace:*",
    "@islands/runtime": "workspace:*",
    "@islands/sdk": "workspace:*",
    "@islands/tooling": "workspace:*",
    "yaml": "2.9.1"
  },
  "engines": { "bun": ">=1.3.14", "node": ">=22" }
}
